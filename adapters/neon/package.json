{
  "name": "@qubu/adapter-neon",
  "version": "0.5.0",
  "description": "Experimental Qubu adapter for Neon's HTTP PostgreSQL client.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleclarson/qubu",
    "directory": "adapters/neon"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.mts",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "qubu": "workspace:*"
  },
  "peerDependencies": {
    "@neondatabase/serverless": ">=1.0.0 <2.0.0",
    "qubu": "0.5.0"
  }
}
