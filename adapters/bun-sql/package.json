{
  "name": "@qubu/adapter-bun-sql",
  "version": "0.6.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleclarson/qubu",
    "directory": "adapters/bun-sql"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./migration": "./src/migration.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.mts",
    "exports": {
      ".": "./dist/index.mjs",
      "./migration": "./dist/migration.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@qubu/migrate": "workspace:*",
    "qubu": "workspace:*"
  },
  "peerDependencies": {
    "@qubu/migrate": "0.6.2",
    "qubu": "0.6.2"
  }
}
