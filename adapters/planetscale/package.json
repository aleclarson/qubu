{
  "name": "@qubu/adapter-planetscale",
  "version": "0.5.1",
  "description": "Experimental Qubu adapter for the PlanetScale serverless MySQL client.",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleclarson/qubu",
    "directory": "adapters/planetscale"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.mts",
    "exports": {
      ".": "./dist/index.mjs",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@planetscale/database": "^1.20.1",
    "qubu": "workspace:*"
  },
  "peerDependencies": {
    "@planetscale/database": ">=1.13.0 <2.0.0",
    "qubu": "0.5.1"
  }
}
