{
  "name": "qubu",
  "version": "0.2.1",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./introspection": "./src/introspection/index.ts",
    "./mysql": "./src/dialects/mysql.ts",
    "./postgres": "./src/dialects/postgres.ts",
    "./snapshot": "./src/snapshot/index.ts",
    "./sqlite": "./src/dialects/sqlite.ts",
    "./vite": "./src/vite/index.ts",
    "./package.json": "./package.json",
    "./globals": "./src/vite/ambient.d.ts"
  },
  "prettier": "@alloc/prettier-config",
  "devDependencies": {
    "@alloc/prettier-config": "^1.0.0",
    "@pg-nano/pg-tmp": "^2.0.3",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.6.2",
    "lildocs": "^0.1.27",
    "picospawn": "^0.3.10",
    "prettier": "^3.6.2",
    "qubu": "link:",
    "radashi": "^12.6.2",
    "tinyglobby": "^0.2.15",
    "tsdown": "^0.22.14",
    "type-fest": "^5.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "playground": "bun run ./playground/playground.ts",
    "test": "vitest",
    "test:bun": "bun test ./src/bun/test",
    "typecheck": "vitest --typecheck --run",
    "typecheck:playground": "tsc --project ./playground/tsconfig.json",
    "lint": "prettier --check . && npm run typecheck"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.mjs",
      "./introspection": "./dist/introspection.mjs",
      "./mysql": "./dist/mysql.mjs",
      "./postgres": "./dist/postgres.mjs",
      "./snapshot": "./dist/snapshot.mjs",
      "./sqlite": "./dist/sqlite.mjs",
      "./vite": "./dist/vite.mjs",
      "./package.json": "./package.json",
      "./globals": "./dist/vite/ambient.d.ts"
    }
  }
}
