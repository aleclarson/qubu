{
  "name": "@qubu/migrate",
  "version": "0.5.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/aleclarson/qubu",
    "directory": "packages/migrate"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./artifact": "./src/artifact/index.ts",
    "./baseline": "./src/baseline/index.ts",
    "./bootstrap": "./src/bootstrap/index.ts",
    "./ddl": "./src/ddl/index.ts",
    "./executor": "./src/executor/index.ts",
    "./journal": "./src/journal/index.ts",
    "./plan": "./src/plan/index.ts",
    "./repository": "./src/repository/index.ts",
    "./status": "./src/status/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./artifact": {
        "types": "./dist/artifact.d.mts",
        "import": "./dist/artifact.mjs"
      },
      "./baseline": {
        "types": "./dist/baseline.d.mts",
        "import": "./dist/baseline.mjs"
      },
      "./bootstrap": {
        "types": "./dist/bootstrap.d.mts",
        "import": "./dist/bootstrap.mjs"
      },
      "./ddl": {
        "types": "./dist/ddl.d.mts",
        "import": "./dist/ddl.mjs"
      },
      "./executor": {
        "types": "./dist/executor.d.mts",
        "import": "./dist/executor.mjs"
      },
      "./journal": {
        "types": "./dist/journal.d.mts",
        "import": "./dist/journal.mjs"
      },
      "./plan": {
        "types": "./dist/plan.d.mts",
        "import": "./dist/plan.mjs"
      },
      "./repository": {
        "types": "./dist/repository.d.mts",
        "import": "./dist/repository.mjs"
      },
      "./status": {
        "types": "./dist/status.d.mts",
        "import": "./dist/status.mjs"
      },
      "./testing": {
        "types": "./dist/testing.d.mts",
        "import": "./dist/testing.mjs"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest --run",
    "typecheck": "vitest --typecheck --run"
  },
  "devDependencies": {
    "qubu": "workspace:*"
  },
  "peerDependencies": {
    "qubu": "0.5.1"
  }
}
